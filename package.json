{
  "name": "class-manager",
  "version": "1.0.0",
  "description": "班级管理大师",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "build:renderer": "vite build",
    "sync:relay": "node scripts/sync-relay-assets.js",
    "build": "node scripts/sync-relay-assets.js && vite build && electron-builder && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-green-zip.ps1 && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-portable.ps1",
    "build:win": "node scripts/sync-relay-assets.js && vite build && electron-builder --win --x64 && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-green-zip.ps1 && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-portable.ps1",
    "build:android": "npx cap sync android && cd android && gradlew assembleDebug && cd .. && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/copy-apk-to-release.ps1",
    "copy:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/copy-apk-to-release.ps1",
    "start": "electron ."
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/barcode-scanner": "^3.1.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "adm-zip": "^0.6.1",
    "qrcode": "^1.5.4",
    "sql.js": "^1.11.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.1.0",
    "electron-builder": "^25.0.5",
    "vite": "^5.4.8",
    "vue": "^3.5.10",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.classmanager.app",
    "productName": "班级管理大师",
    "publish": null,
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "electron/**/*",
      "mobile/**/*",
      "dist/**/*",
      "package.json",
      "node_modules/adm-zip/**/*",
      "node_modules/qrcode/**/*",
      "node_modules/sql.js/**/*",
      "node_modules/ws/**/*",
      "!node_modules/@capacitor/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "班级管理大师",
      "artifactName": "班级管理大师-安装版-${version}.${ext}"
    }
  }
}
